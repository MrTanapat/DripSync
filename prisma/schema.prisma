generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum RoastLevel {
    LIGHT
    MEDIUM
    MEDIUM_DARK
    DARK
}

enum ProcessType {
    WASHED
    NATURAL
    HONEY
    ANAEROBIC
    OTHER
}

model Bean {
    id         String      @id @default(cuid())
    name       String
    roaster    String
    roastLevel RoastLevel
    process    ProcessType
    tasteNotes String?

    price  Float
    weight Float

    isFinished Boolean @default(false)

    brewLogs BrewLog[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model BrewLog {
    id String @id @default(cuid())

    coffeeDose Float
    waterYield Float
    waterTemp  Float
    grindSize  String
    brewTime   Int

    rating Int
    notes  String?

    beanId String
    bean   Bean   @relation(fields: [beanId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
